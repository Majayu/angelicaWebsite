<?php
session_start();
if (!isset($_SESSION["user"])) {
    header("Location: login.html");
    exit;
}

include 'db.php';

if (isset($_POST['update'])) {
    $id = $_POST['id'];
    $customer_name = $_POST['customer_name'];
    $phone = $_POST['phone'];
    $service = $_POST['service'];
    $appointment_date = $_POST['appointment_date'];

    $stmt = $conn->prepare("UPDATE appointments SET customer_name=?, phone=?, service=?, appointment_date=? WHERE id=?");
    $stmt->bind_param("ssssi", $customer_name, $phone, $service, $appointment_date, $id);
    
    if ($stmt->execute()) {
        header("Location: dashboard.php");
        exit;
    } else {
        echo "Error updating appointment.";
    }
}

if (isset($_GET['id'])) {
    $id = $_GET['id'];
    $result = $conn->query("SELECT * FROM appointments WHERE id=$id");
    $appointment = $result->fetch_assoc();
} else {
    header("Location: dashboard.php");
    exit;
}

$conn->close();
?>

